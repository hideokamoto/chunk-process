{
  "name": "chunk-process",
  "version": "0.1.0",
  "description": "Chunked parallel async task runner for rate limiting and resource control",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint libs/",
    "lint:fix": "eslint libs/ --fix",
    "doc": "typedoc --out docs libs/ && touch docs/.nojekyll",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "keywords": [
    "batch",
    "chunk",
    "async",
    "promise",
    "rate-limit",
    "throttle",
    "parallel",
    "processing"
  ],
  "bugs": {
    "url": "https://github.com/hideokamoto/chunk-process/issues"
  },
  "homepage": "https://github.com/hideokamoto/chunk-process#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hideokamoto/chunk-process.git"
  },
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "tslib": "^2.8.1",
    "typedoc": "^0.27.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.27.1"
}
